# Desenvolvimento local/offline; copiar para .env.local (ignorado pelo Git).
COMPOSE_PROJECT_NAME=rfid-hospital-local
HOST_UID=1000
HOST_GID=1000

MQTT_MODE=local
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_ID=easy-local-ingestor
MQTT_TOPIC=easy/dev/hupaa/+/+/readings
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_RECONNECT_INITIAL_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
MQTT_RECONNECT_MULTIPLIER=2
MQTT_RECONNECT_JITTER=0.2
DB_RETRY_INITIAL_DELAY=1
DB_RETRY_MAX_DELAY=30
DB_RETRY_MULTIPLIER=2
DB_RETRY_JITTER=0.2
EVENTS_FILE=data/raw_events.jsonl
LOG_LEVEL=INFO

# Normalização no ingestor: limite em bytes antes do parsing JSON.
MQTT_MAX_PAYLOAD_BYTES=65536
RFID_DEFAULT_ADAPTER=ez700

# Objeto JSON; exemplo: RFID_READER_ADAPTERS='{"reader-02":"simulator"}'
RFID_READER_ADAPTERS='{}'

# Default seguro. Para nosso simulador ez700, selecionar epoch_ms explicitamente.
# Timestamp do EZ700 físico: PENDENTE DE VALIDAÇÃO FÍSICA.
EZ700_TIMESTAMP_FORMAT=rfc3339

# Parâmetros iniciais do debounce; calibrar com dados reais de campo do HUPAA.
RFID_DEBOUNCE_WINDOW_MS=250
RFID_OUT_OF_ORDER_TOLERANCE_MS=1000
RFID_PASSAGE_MAX_INTERVAL_MS=3000
# Após uma passagem: ruído do lado oposto ignorado; sobreposição tolerada entre
# antenas; janela em que a origem não pode continuar lendo a tag (reflexão).
RFID_PASSAGE_REFRACTORY_MS=1000
RFID_PASSAGE_OVERLAP_GRACE_MS=300
RFID_PASSAGE_ORIGIN_HOLD_MS=1000
RFID_DIRECTION_AMBIGUITY_MS=100

# CONFIGURAÇÃO PROVISÓRIA DO MVP: recência da última detecção na API.
# Limite ainda não validado operacionalmente com o HUPAA.
RFID_RECENCY_THRESHOLD_MINUTES=30

# Autenticação da API (ISS-026). Lidas pelo processo da API; valor presente e
# inválido impede a subida (não vira padrão silencioso).
SESSAO_DURACAO_MINUTOS=480
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Cookie de sessão só por HTTPS. Navegadores tratam http://localhost como
# contexto seguro; use false só para clientes que não o fazem (ex.: curl por HTTP).
SESSAO_COOKIE_SEGURO=true

# Credenciais exclusivamente de desenvolvimento. O Compose usa o DNS `postgres`
# internamente; esta URL com localhost serve para comandos executados no host.
POSTGRES_DB=rfid_hospital_dev
POSTGRES_USER=rfid_dev
POSTGRES_PASSWORD=rfid_dev_only
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://rfid_dev:rfid_dev_only@localhost:5432/rfid_hospital_dev

# O ingestor usa APP_DATABASE_URL; no ambiente local ela aponta para o
# mesmo PostgreSQL, sem pooler. Em Neon, use a URL pooled conforme a documentação.
APP_DATABASE_URL=postgresql+psycopg2://rfid_dev:rfid_dev_only@localhost:5432/rfid_hospital_dev
