# Copie os valores necessários para um arquivo .env local e carregue-o no shell.
# Não registre usuário ou senha reais no Git.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC=rfid/+/tags
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=rfid-mvp-receiver
MQTT_QOS=1
EVENTS_FILE=data/raw_events.jsonl
LOG_LEVEL=INFO
