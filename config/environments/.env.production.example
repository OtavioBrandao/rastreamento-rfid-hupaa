# Produção (hospital). Copie para .env.production FORA do Git ou injete pelo
# cofre de segredos do provedor. Valores abaixo são marcadores, não segredos.
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# Simulador web: proibido em produção (a API não sobe se for true).
SIMULADOR_HABILITADO=false

# --- Banco (PostgreSQL gerenciado; use sslmode=require) ---
# DATABASE_URL: API e migrations (endpoint direto). APP_DATABASE_URL: ingestor (pooler).
DATABASE_URL=postgresql+psycopg2://usuario:troque@host-direto.exemplo/rfid_hupaa?sslmode=require
APP_DATABASE_URL=postgresql+psycopg2://usuario:troque@host-pooler.exemplo/rfid_hupaa?sslmode=require
# Conexões por processo da API (multiplique pelos workers ao comparar com o limite do provedor).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_S=300
DB_CONNECT_TIMEOUT_S=5
# Só para --profile banco-local:
POSTGRES_DB=rfid_hupaa
POSTGRES_USER=rfid_hupaa
POSTGRES_PASSWORD=

# --- API ---
API_WORKERS=2
# IPs do proxy reverso autorizados a informar X-Forwarded-* (rede interna do Compose).
FORWARDED_ALLOW_IPS=172.16.0.0/12
SESSAO_COOKIE_SEGURO=true
SESSAO_DURACAO_MINUTOS=480
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Vazio = frontend e API na mesma origem (recomendado). Só HTTPS em produção.
CORS_ORIGENS=
RFID_RECENCY_THRESHOLD_MINUTES=30
RFID_READER_DEGRADED_SECONDS=30
RFID_READER_OFFLINE_SECONDS=90

# --- Ingestor MQTT (assinatura; credencial própria, só Subscribe) ---
MQTT_MODE=cloud
MQTT_HOST=seu-cluster.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_INSECURE_LAB=false
MQTT_USERNAME=ingestor-producao
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_ID=hupaa-ingestor-producao
MQTT_TOPIC=easy/prod/hupaa/+/+/readings
MQTT_HEARTBEAT_TOPIC=
MQTT_QOS=1
MQTT_KEEPALIVE=60
RFID_DEFAULT_ADAPTER=ez700
RFID_READER_ADAPTERS='{}'
# Contador do EZ700 observado nos ensaios: usa o horário de recepção.
EZ700_TIMESTAMP_FORMAT=counter
EVENTS_FILE=data/raw_events.jsonl
RFID_DEBOUNCE_WINDOW_MS=250
RFID_OUT_OF_ORDER_TOLERANCE_MS=1000
RFID_DEBOUNCE_MAX_OBSERVATION_MS=500
RFID_PASSAGE_MAX_INTERVAL_MS=0
RFID_PASSAGE_REFRACTORY_MS=1000
RFID_PASSAGE_OVERLAP_GRACE_MS=300
RFID_PASSAGE_ORIGIN_HOLD_MS=1000
RFID_DIRECTION_AMBIGUITY_MS=100

# --- Web ---
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
