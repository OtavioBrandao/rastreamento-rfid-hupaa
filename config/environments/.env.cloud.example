# Perfil do ingestor; copiar para .env.cloud (ignorado pelo Git).
# Preencher endpoint, usuário e senha fora do Git. Host sem mqtts://.
COMPOSE_PROJECT_NAME=rfid-hospital-managed
HOST_UID=1000
HOST_GID=1000

MQTT_MODE=cloud
MQTT_HOST=endpoint-do-cluster.hivemq.cloud
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=easy-cloud-ingestor
MQTT_TOPIC=easy/dev/hupaa/+/+/readings
MQTT_CA_CERT=
# Ensaio de laboratório sem TLS (launcher --mqtt-transport plain): HiveMQ Cloud
# não aceita 1883; use outro broker, ex.: broker.hivemq.com. Usuário/senha opcionais.
MQTT_PLAIN_HOST=
MQTT_PLAIN_PORT=1883
MQTT_PLAIN_USERNAME=
MQTT_PLAIN_PASSWORD=
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_RECONNECT_INITIAL_DELAY=1
MQTT_RECONNECT_MAX_DELAY=30
MQTT_RECONNECT_MULTIPLIER=2
MQTT_RECONNECT_JITTER=0.2
DB_RETRY_INITIAL_DELAY=1
DB_RETRY_MAX_DELAY=30
DB_RETRY_MULTIPLIER=2
DB_RETRY_JITTER=0.2
EVENTS_FILE=data/raw_events.jsonl
LOG_LEVEL=INFO

# Normalização no ingestor: limite em bytes antes do parsing JSON.
MQTT_MAX_PAYLOAD_BYTES=65536
RFID_DEFAULT_ADAPTER=ez700

# Objeto JSON; exemplo: RFID_READER_ADAPTERS='{"reader-02":"simulator"}'
RFID_READER_ADAPTERS='{}'

# Perfil legado; números do EZ700 são contadores e usam a recepção UTC.
# RFC3339 com fuso continua aceito. Unidade de RSSI depende de validação física.
EZ700_TIMESTAMP_FORMAT=rfc3339

# Parâmetros iniciais do debounce; calibrar com dados reais de campo do HUPAA.
RFID_DEBOUNCE_WINDOW_MS=250
RFID_OUT_OF_ORDER_TOLERANCE_MS=1000
RFID_DEBOUNCE_MAX_OBSERVATION_MS=500
RFID_PASSAGE_MAX_INTERVAL_MS=0
# Após uma passagem: ruído do lado oposto ignorado; sobreposição tolerada entre
# antenas; janela em que a origem não pode continuar lendo a tag (reflexão).
RFID_PASSAGE_REFRACTORY_MS=1000
RFID_PASSAGE_OVERLAP_GRACE_MS=300
RFID_PASSAGE_ORIGIN_HOLD_MS=1000
RFID_DIRECTION_AMBIGUITY_MS=100

# CONFIGURAÇÃO PROVISÓRIA DO MVP: recência da última detecção na API.
# Limite ainda não validado operacionalmente com o HUPAA.
RFID_RECENCY_THRESHOLD_MINUTES=30

# Autenticação da API (ISS-026). Lidas pelo processo da API; valor presente e
# inválido impede a subida (não vira padrão silencioso).
SESSAO_DURACAO_MINUTOS=480
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15
# Cookie de sessão só por HTTPS. Navegadores tratam http://localhost como
# contexto seguro; use false só para clientes que não o fazem (ex.: curl por HTTP).
SESSAO_COOKIE_SEGURO=true

# URL externa completa, com SSL conforme o provedor. Deixar vazia no exemplo
# impede que o perfil managed avance por engano com um destino fictício.
DATABASE_URL=
APP_DATABASE_URL=postgresql+psycopg2://user:password@host-pooler/dbname?sslmode=require&channel_binding=require

# Monitoramento de leitores. Mesmos limites no ingestor e na API.
RFID_READER_DEGRADED_SECONDS=30
RFID_READER_OFFLINE_SECONDS=90
# Opcional; habilite só com ACL de assinatura e fonte de heartbeat configuradas.
# Contrato do software, não presumido no EZ700. Vazio mantém somente leituras.
MQTT_HEARTBEAT_TOPIC=
# Exemplo: easy/dev/hupaa/+/+/heartbeat
