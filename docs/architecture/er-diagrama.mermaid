erDiagram
    TIPOS_EQUIPAMENTO ||--o{ EQUIPAMENTOS : classifica
    EQUIPAMENTOS ||--o{ ASSOCIACOES_TAG_EQUIPAMENTO : "possui historico de"
    TAGS ||--o{ ASSOCIACOES_TAG_EQUIPAMENTO : "vinculada em"

    ANDARES ||--o{ SETORES : contem
    SETORES ||--o{ ZONAS : contem
    ZONAS ||--o{ PORTAIS : "lado A"
    ZONAS ||--o{ PORTAIS : "lado B"
    PORTAIS ||--o{ ANTENAS : "agrega (antenas de leitores distintos)"
    PORTAIS ||--o{ MAPEAMENTOS_ANTENA_PORTAL : "historico topologia"
    ANTENAS ||--o{ MAPEAMENTOS_ANTENA_PORTAL : "historico alocacao"
    ZONAS ||--o{ MAPEAMENTOS_ANTENA_PORTAL : "coberta por"
    ZONAS ||--o{ ANTENAS : cobre
    LEITORES ||--o{ ANTENAS : possui

    ANTENAS ||--o{ LEITURAS_BRUTAS : gera
    PORTAIS ||--o{ PASSAGENS : "ocorre em"
    ANTENAS ||--o{ PASSAGENS : "origem"
    ANTENAS ||--o{ PASSAGENS : "destino (opcional)"
    LEITURAS_BRUTAS ||--o{ PASSAGENS : "evidencia origem"
    LEITURAS_BRUTAS ||--o{ PASSAGENS : "evidencia destino (opcional)"

    EQUIPAMENTOS ||--o{ HISTORICO_MOVIMENTACOES : historico
    ZONAS ||--o{ HISTORICO_MOVIMENTACOES : "zona origem (opcional)"
    ZONAS ||--o{ HISTORICO_MOVIMENTACOES : "zona destino"
    PASSAGENS ||--o| HISTORICO_MOVIMENTACOES : "gera (opcional)"
    PORTAIS ||--o{ HISTORICO_MOVIMENTACOES : "portal observado"
    LEITURAS_BRUTAS ||--o{ HISTORICO_MOVIMENTACOES : "evidencia origem"
    LEITURAS_BRUTAS ||--o{ HISTORICO_MOVIMENTACOES : "evidencia destino"
    HISTORICO_MOVIMENTACOES ||--o{ HISTORICO_MOVIMENTACOES : "registro anterior"
    HISTORICO_MOVIMENTACOES ||--o{ EQUIPAMENTOS : "origem da ultima localizacao"
    ZONAS ||--o{ EQUIPAMENTOS : "ultima zona conhecida (opcional)"

    PERFIS ||--o{ USUARIOS : define
    USUARIOS ||--o{ AUDITORIAS : realiza
    USUARIOS ||--o{ SESSOES : "abre (ISS-026)"

    TIPOS_EQUIPAMENTO {
        bigint id PK
        string nome UK
        string descricao
    }

    EQUIPAMENTOS {
        bigint id PK
        string nome
        bigint tipo_id FK
        string identificador_interno UK
        string status
        bigint ultima_zona_id FK
        timestamptz ultima_deteccao_em
        bigint ultima_passagem_id FK
        bigint ultima_movimentacao_id FK
        bigint versao "versao otimista (ISS-025)"
        timestamptz created_at
        timestamptz updated_at
    }

    TAGS {
        bigint id PK
        string epc UK
        timestamptz criada_em
    }

    ASSOCIACOES_TAG_EQUIPAMENTO {
        bigint id PK
        bigint tag_id FK
        bigint equipamento_id FK
        timestamptz inicio
        timestamptz fim "NULL = ativa; unico ativo; CHECK fim >= inicio"
    }

    ANDARES {
        bigint id PK
        string nome UK
    }

    SETORES {
        bigint id PK
        bigint andar_id FK
        string nome
    }

    ZONAS {
        bigint id PK
        bigint setor_id FK
        string nome
        text observacoes "ex.: presenca de zona morta"
    }

    PORTAIS {
        bigint id PK
        string nome
        bigint zona_a_id FK
        bigint zona_b_id FK
        text localizacao_fisica
        boolean ativo
        timestamptz created_at
        timestamptz updated_at
    }

    LEITORES {
        bigint id PK
        string reader_id UK "origem no MQTT"
        string fabricante
        string modelo
        string identificador_serial UK "serie de fabrica"
        string endereco_rede
        jsonb parametros_ingestao "nao-secreto"
        string status "conectividade ao vivo"
        timestamptz ultimo_heartbeat_em
        timestamptz ultimo_contato_em
        string origem_ultimo_contato
        string saude_reportada
        boolean ativo "cadastro"
        timestamptz created_at
        timestamptz updated_at
    }

    ANTENAS {
        bigint id PK
        bigint leitor_id FK
        bigint portal_id FK "opcional"
        int porta_numero
        bigint zona_associada_id FK
        string funcao "entrada, saida, indefinido"
        boolean ativo "UK(leitor,porta) so entre ativas"
        timestamptz created_at
        timestamptz updated_at
    }

    MAPEAMENTOS_ANTENA_PORTAL {
        bigint id PK
        bigint portal_id FK
        bigint antena_id FK
        bigint zona_id FK
        string lado "A, B"
        string funcao "entrada, saida, auxiliar"
        timestamptz inicio
        timestamptz fim "NULL = ativo; uq_mapeamento_antena_ativo; CHECK fim >= inicio"
        timestamptz created_at
    }

    LEITURAS_BRUTAS {
        bigint id PK
        varchar_71 event_id UK "SHA-256 canonico, sem default"
        bigint antena_id FK
        string epc "sem FK direta p/ tags"
        numeric rssi "nullable"
        jsonb dados_origem
        timestamptz lido_em
        timestamptz recebido_em
    }

    PASSAGENS {
        bigint id PK
        string epc
        bigint portal_id FK
        bigint antena_origem_id FK
        bigint antena_destino_id FK "opcional, RF-011 e Should"
        string direcao "a_para_b, b_para_a, indeterminada"
        string direcao_status "confirmed, ambiguous, unknown"
        string direcao_regra
        bigint zona_origem_id FK
        bigint zona_destino_id FK
        bigint leitura_origem_id FK
        bigint leitura_destino_id FK "opcional"
        timestamptz detectada_em
    }

    HISTORICO_MOVIMENTACOES {
        bigint id PK
        bigint equipamento_id FK
        bigint zona_origem_id FK "opcional"
        bigint zona_destino_id FK
        bigint passagem_id FK "opcional, NULL = correcao manual"
        string epc "observado"
        bigint portal_id FK
        bigint leitura_origem_id FK
        bigint leitura_destino_id FK
        timestamptz movimentada_em "event time"
        string origem_registro "passagem_automatica, correcao_manual"
        timestamptz registrado_em
        string justificativa "correcao manual"
        string referencia "chamado/OS da correcao (ISS-025)"
        bigint registro_anterior_id FK
    }

    PERFIS {
        bigint id PK
        string nome UK
    }

    USUARIOS {
        bigint id PK
        string nome
        string email UK
        string senha_hash "Argon2id"
        bigint perfil_id FK
        boolean ativo
        boolean deve_trocar_senha
        int tentativas_falhas
        timestamptz bloqueado_ate
        timestamptz ultimo_login_em
        timestamptz created_at
        timestamptz updated_at
    }

    SESSOES {
        bigint id PK
        bigint usuario_id FK
        string token_hash UK "SHA-256 do token"
        timestamptz criada_em
        timestamptz expira_em
        timestamptz revogada_em
        string motivo_revogacao "logout, troca_senha, redefinicao_senha, desativacao"
    }

    AUDITORIAS {
        bigint id PK "append-only (trigger)"
        bigint usuario_id FK "autor; NULL = sistema ou anonimo"
        string origem "usuario, sistema, anonimo"
        string entidade
        bigint entidade_id "NULL = sem alvo"
        string acao "catalogo ISS-028 (14 acoes)"
        string motivo
        string correlation_id
        jsonb dados_antes
        jsonb dados_depois
        timestamptz registrado_em
    }

    SIMULACAO_LAYOUTS ||--o{ SIMULACAO_SESSOES : "inicia"

    SIMULACAO_LAYOUTS {
        bigint id PK
        string nome
        string cenario "easy, hupaa"
        jsonb configuracao "zonas, portais, leitores, antenas (0-100)"
        jsonb vinculos "ids da topologia aplicada"
        bigint versao "otimista"
        boolean arquivado
        timestamptz aplicado_em
    }

    SIMULACAO_SESSOES {
        bigint id PK
        string codigo UK "link da aba de controle"
        bigint layout_id FK
        string cenario
        jsonb layout "fotografia no inicio"
        jsonb topologia "ids por chave"
        jsonb itens "posicao virtual e EPC opcional"
        string estado "em_execucao, pausada, encerrada"
        bigint versao
        bigint criada_por "sem FK"
    }

