# Imagem única do backend (monólito modular): API FastAPI, ingestor MQTT e migrations.
# O processo é escolhido pelo comando do serviço (ver deploy/production/compose.yaml).
FROM python:3.12.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY requirements/base.txt ./requirements/base.txt
RUN python -m pip install -r requirements/base.txt

COPY config/alembic.ini ./config/alembic.ini
COPY alembic ./alembic
COPY db ./db
COPY api ./api
COPY rfid_ingestion ./rfid_ingestion
COPY rfid_inference ./rfid_inference
COPY rfid_movement ./rfid_movement
COPY rfid_location ./rfid_location
COPY docker ./docker

RUN chmod +x /app/docker/require-database-url.sh \
    && mkdir -p /app/data \
    && chown -R app:app /app/data

USER app
EXPOSE 8000

# Liveness da API; o ingestor sobrescreve com `python -m rfid_ingestion.health`.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=4 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

# --proxy-headers: o TLS termina no proxy reverso; só os IPs em FORWARDED_ALLOW_IPS são confiáveis.
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-127.0.0.1}\" --workers \"${API_WORKERS:-2}\" --no-server-header"]
