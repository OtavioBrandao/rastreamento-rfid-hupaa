# Perfil do ingestor; copiar para .env.local (ignorado pelo Git).
MQTT_MODE=local
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TLS_ENABLED=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_ID=easy-local-ingestor
MQTT_TOPIC=easy/dev/hupaa/+/+/readings
MQTT_QOS=1
MQTT_KEEPALIVE=60
EVENTS_FILE=data/raw_events.jsonl
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://user:password@host/dbname
